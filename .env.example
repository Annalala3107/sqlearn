# ========================================================
# SQL THÁM TỬ - CẤU HÌNH XÁC THỰC GOOGLE OAUTH 2.0 (GIS)
# ========================================================

# 1. Google OAuth Client ID
# Lấy từ: https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Authorized JavaScript origins: http://localhost:3000 (và domain chính thức khi deploy)
VITE_GOOGLE_CLIENT_ID=

# 2. Danh sách Gmail Quản Trị Viên (Admin) được phép truy cập Cổng Quản Trị
# Phân cách các email bằng dấu phẩy (không phân biệt chữ hoa/thường)
VITE_ADMIN_EMAILS=admin.nam@sqlearn.vn
